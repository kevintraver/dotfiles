#!/bin/bash
# update-packages - Update all package managers

LOG="$HOME/.local/log/update-packages.log"
mkdir -p "$(dirname "$LOG")"

# Keep only the most recent output
[[ -f "$LOG" ]] && tail -n 5000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"

exec > >(tee -a "$LOG") 2>&1

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

# usage: step <label> <command...>
step() {
  local label=$1
  shift
  "$@"
  local status=$?
  if ((status == 0)); then
    log "✓ $label"
  else
    log "✗ $label (exit $status)"
  fi
}

brew_update() { brew update && brew upgrade --greedy-auto-updates && brew cleanup; }
lazy_sync() { timeout 600 nvim --headless "+Lazy! sync" +qa >/dev/null 2>&1; }
# Keep agent-browser on its own Chrome for Testing so headless runs don't hijack the real Chrome
agent_browser_install() {
  agent-browser install || return
  ls -d "$HOME"/.agent-browser/browsers/chrome-* | sort -V | sed '$d' | xargs -r rm -rf
}

log "Starting package updates..."

step "Homebrew packages" brew_update
step "mise tools" mise upgrade
step "bun global packages" bun update --global
step "pipx packages" pipx upgrade-all
step "Rust packages" cargo install-update -a
step "agent-browser Chrome" agent_browser_install
step "Neovim plugins" lazy_sync
step "Mason packages" timeout 600 nvim --headless -c 'autocmd User MasonUpdateAllComplete quitall' -c 'MasonUpdateAll'

log "All package updates complete"
