#!/bin/zsh -f
# Focus the application currently playing audio

BT="$HOME/.local/bin/bt"
YABAI="/opt/homebrew/bin/yabai"
JQ="/opt/homebrew/bin/jq"
STATE_FILE="$HOME/.local/state/focus-now-playing"
# A notification sound keeps its audio assertion for about 30 seconds
FRESH_SECS=40

# Get power assertions
assertions=$(LC_ALL=C pmset -g assertions)

# List coreaudiod audio assertions as "fresh pid" lines, best candidate first:
# assertions older than FRESH_SECS before younger ones (which may be a notification
# sound), then youngest first, then processes holding their own power assertion
# (e.g. "IINA playback is in progress").
# Skip assertions that use the mic (e.g. superwhisper ducking audio while dictating)
audio=$(echo "$assertions" | awk -v fresh_secs="$FRESH_SECS" '
  /^ *pid [0-9]+\(/ && !/\(coreaudiod\)/ { split($2, owner, "("); own[owner[1]] = 1 }
  /coreaudiod.*audio/ && match($0, /[0-9]+:[0-9]+:[0-9]+/) {
    split(substr($0, RSTART, RLENGTH), t, ":")
    age = t[1] * 3600 + t[2] * 60 + t[3]
    getline; if (!/Created for PID:/ || !match($0, /[0-9]+/)) next
    pid = substr($0, RSTART, RLENGTH)
    getline; if (!/audio-in/) { n++; pids[n] = pid; ages[n] = age }
  }
  END {
    for (i = 1; i <= n; i++) {
      fresh = (ages[i] < fresh_secs) ? 1 : 0
      no_own = (pids[i] in own) ? 0 : 1
      print fresh, ages[i], no_own, pids[i]
    }
  }' 2>/dev/null | sort -k1,1n -k2,2n -k3,3n | cut -d' ' -f1,4)

# Find first candidate that's actually playing (skip browsers without audible tabs)
app_path=""
app_fresh=""
audible_tabs=""
for entry in ${(f)audio}; do
  candidate="${entry#* }"
  candidate_path=$(ps -p "$candidate" -o comm= 2>/dev/null)
  # Skip exited processes and anything outside an app bundle (e.g. mpv, afplay)
  [[ "$candidate_path" != *".app/"* ]] && continue
  # Skip XPC services; browser audio helpers resolve to their owning app below
  [[ "$candidate_path" == *"/XPCServices/"* || "$candidate_path" == *".xpc/"* ]] && continue
  # Check if it's Zen Browser - only use if it has audible tabs
  if [[ "$candidate_path" == *"Zen Browser"* ]]; then
    audible_tabs=$($BT query +audible 2>/dev/null)
    # brotab also prints nothing when it can't reach the browser, so only
    # treat Zen as silent while its mediator is running
    [[ -z "$audible_tabs" ]] && pgrep -qf bt_mediator && continue
  fi
  app_path="$candidate_path"
  app_fresh="${entry% *}"
  break
done
if [[ -n "$app_path" ]]; then
  # Use the outermost app bundle, including for nested browser helpers
  app_name="${app_path%%.app/*}"
  app_name="${app_name##*/}"
fi

# If no app playing, try fallback to last playing app (excluding Zen)
if [[ -z "$app_name" ]]; then
  if [[ -f "$STATE_FILE" ]]; then
    last_app=$(<"$STATE_FILE")
    if [[ -n "$last_app" ]]; then
      open -a "$last_app" 2>/dev/null
    fi
  fi
  exit 0
fi

# If it's Zen Browser, focus the specific audible tab and window via yabai
if [[ "${app_name:l}" == "zen" || "${app_name:l}" == "zen browser" ]]; then
  read -r tab_line <<< "$audible_tabs"
  if [[ -n "$tab_line" ]]; then
    IFS=$'\t' read -r tab_id tab_title _ <<< "$tab_line"
    $BT activate "$tab_id" 2>/dev/null

    # Match the window on the full tab title. After a tab switch the window
    # title lags by ~100ms, so retry, and only on the last attempt settle for
    # a match on the first 20 chars
    for attempt in 1 2 3 4 5 6; do
      window_info=$($YABAI -m query --windows | $JQ -r \
        --arg title "$tab_title" --argjson loose "$(( attempt == 6 ))" \
        '[.[] | select(.app == "Zen")] as $zen
        | first(
            ($zen[] | select(.title == $title)),
            ($zen[] | select(.title | contains($title))),
            ($zen[] | select($loose == 1 and (.title | contains($title[0:20]))))
          ) | "\(.id) \(.["has-focus"])"')
      [[ -n "$window_info" || $attempt == 6 ]] && break
      sleep 0.05
    done
    read -r window_id has_focus <<< "$window_info"

    if [[ -n "$window_id" && "$has_focus" != "true" ]]; then
      $YABAI -m window "$window_id" --focus
      $YABAI -m window "$window_id" --raise 2>/dev/null || true
    elif [[ -z "$window_id" ]]; then
      open -a "Zen Browser" 2>/dev/null
    fi
  else
    open -a "Zen Browser" 2>/dev/null
  fi
else
  # Activate other apps normally and save as last playing, unless the
  # assertion is fresh enough to be a notification sound
  [[ "$app_fresh" == 0 ]] && echo "$app_name" > "$STATE_FILE"
  open -a "$app_name" 2>/dev/null
fi
