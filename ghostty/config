# https://ghostty.org/docs/config/reference

font-family = "Hack"

macos-option-as-alt = true

keybind = "super+w=text:\x1bw"
keybind = "super+q=unbind"
keybind = "super+e=text:\x1be"
keybind = "super+a=unbind"
keybind = "super+m=unbind"
keybind = "super+f=unbind"
keybind = "super+ctrl+f=csi:102;13u"

keybind = "shift+enter=text:\x1b\r"

theme = tokyonight

# Splits are only side by side. performable: passes the key through to the
# terminal app when there's no split in that direction.
keybind = "performable:ctrl+h=goto_split:left"
keybind = "performable:ctrl+l=goto_split:right"

maximize = true
mouse-hide-while-typing = true

working-directory = "/Users/kevin/.dotfiles"

auto-update-channel = tip

# Send TERM=xterm-256color over SSH so remote hosts without Ghostty terminfo work
shell-integration-features = ssh-env
