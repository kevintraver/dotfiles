# Environment variables for all shell types (interactive and non-interactive)

export GOPATH="$HOME/.go"

# agent-browser: native mode; disable Chrome's Translate and menu bar search icon
export AGENT_BROWSER_NATIVE=1
export AGENT_BROWSER_ARGS="--disable-features=Translate,OmniboxEverywhere"

export NODE_OPTIONS="--no-deprecation"

export EDITOR="nvim" VISUAL="nvim"
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
export FZF_DEFAULT_OPTS="--height=50% --layout=reverse --bind=tab:accept"
export ANDROID_HOME="$HOME/Library/Android/sdk"

# Machine-specific variables, kept out of this public repo
[[ -r ~/.zshenv.local ]] && source ~/.zshenv.local

# The one place PATH order is decided, for scripts and agent shells too: mise
# shims (https://mise.jdx.dev/), then user bins, then Homebrew, so rustup's
# cargo wins over Homebrew's rust. Interactive shells add mise's hooks in zshrc.
prepend_user_paths() {
  path=(
    "$HOME/.local/share/mise/shims"
    "$HOME/.go/bin" "$HOME/.cargo/bin" "$HOME/.local/bin"
    /opt/homebrew/bin /opt/homebrew/sbin
    $path
    "$ANDROID_HOME/platform-tools"
  )
}
typeset -U path
export PATH
prepend_user_paths

# https://fnox.jdx.dev/
(( $+commands[fnox] )) && [[ -r ~/.config/fnox/config.toml ]] &&
  eval "$(fnox -c ~/.config/fnox/config.toml --non-interactive export --format shell)"
